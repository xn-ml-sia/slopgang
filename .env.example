# Copy to .env.local if you want to override defaults.
# None of these are required for the demo path.

# Reddit public JSON (proxied in vite dev/preview). Datacenter IPs are often 403'd.
VITE_ENABLE_REDDIT=true
VITE_REDDIT_SUBREDDIT=midjourney
VITE_REDDIT_SORT=hot
# Optional: search instead of a subreddit listing
# VITE_REDDIT_QUERY=AI slop

# RSS/Atom (proxied). Default is 404 Media.
VITE_ENABLE_RSS=true
VITE_RSS_FEED_URL=https://www.404media.co/rss/
