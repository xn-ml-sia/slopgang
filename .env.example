# Copy to .env.local if you want to override defaults.
# None of these are required for the demo path (seed archive + public RSS).
# Never commit real tokens. Server-only keys must NOT use the VITE_ prefix.

# Reddit public JSON (proxied in vite dev/preview). Datacenter IPs are often 403'd.
VITE_ENABLE_REDDIT=true
VITE_REDDIT_SUBREDDIT=midjourney
VITE_REDDIT_SORT=hot
# Optional: search instead of a subreddit listing
# VITE_REDDIT_QUERY=AI slop

# RSS/Atom (proxied). Default is 404 Media.
VITE_ENABLE_RSS=true
VITE_RSS_FEED_URL=https://www.404media.co/rss/

# X.com / Twitter. Official API needs a server-only bearer token.
# Without X_BEARER_TOKEN, the adapter is `unconfigured` unless you set an RSS bridge.
VITE_ENABLE_X=true
VITE_X_HANDLE=
VITE_X_QUERY=
# Optional Nitter-style or RSSHub feed. `{handle}` and `{query}` are substituted.
# Example: https://nitter.privacydev.net/{handle}/rss
VITE_X_RSS_URL=
# X_BEARER_TOKEN=
# TWITTER_BEARER_TOKEN=

# Instagram. Graph API needs a server-only access token (Instagram Login / Basic Display successor).
# Without INSTAGRAM_ACCESS_TOKEN, the adapter is `unconfigured` unless you set an RSS bridge.
VITE_ENABLE_INSTAGRAM=true
VITE_INSTAGRAM_USERNAME=
VITE_INSTAGRAM_HASHTAG=
# Optional RSSHub (or similar) feed. `{username}` and `{hashtag}` are substituted.
# Example: https://rsshub.app/instagram/user/{username}
VITE_INSTAGRAM_RSS_URL=
# INSTAGRAM_ACCESS_TOKEN=
# IG_ACCESS_TOKEN=
